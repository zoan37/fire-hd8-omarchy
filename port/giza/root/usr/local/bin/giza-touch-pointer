#!/usr/bin/python3
"""Adapt the legacy Goodix MT-only input to an absolute click pointer."""
import fcntl
import os
import struct
import time
from pathlib import Path

EVENT = struct.Struct('llHHi')
timing = os.getenv('GIZA_TOUCH_TIMING') == '1'
source = os.open('/dev/input/event3', os.O_RDONLY)
target = os.open('/dev/uinput', os.O_WRONLY | os.O_NONBLOCK)
for kind in (0, 1, 3):
    fcntl.ioctl(target, 0x40045564, kind)  # UI_SET_EVBIT
fcntl.ioctl(target, 0x40045565, 0x110)  # BTN_LEFT
for axis in (0, 1):
    fcntl.ioctl(target, 0x40045567, axis)
maxima, minima = [0] * 64, [0] * 64
for axis, mt in ((0, 0x35), (1, 0x36)):
    info = struct.unpack('6i', fcntl.ioctl(source, 0x80184540 + mt, bytes(24)))
    minima[axis], maxima[axis] = info[1], info[2]
descriptor = struct.pack('80sHHHHI', b'giza-touch-pointer', 3, 1, 1, 1, 0)
descriptor += struct.pack('256i', *(maxima + minima + [0] * 128))
os.write(target, descriptor)
fcntl.ioctl(target, 0x5501)  # UI_DEV_CREATE
for attempt in range(100):
    for entry in Path('/sys/class/input').glob('event*'):
        if (entry / 'device/name').read_text().strip() == 'giza-touch-pointer':
            Path('/run/giza-touch-event').write_text('/dev/input/' + entry.name + '\n')
            alias = Path('/dev/input/giza-touch-pointer')
            alias.unlink(missing_ok=True)
            alias.symlink_to(entry.name)
            break
    else:
        time.sleep(0.05)
        continue
    break
else:
    raise RuntimeError('uinput event node did not appear')
print('Goodix pointer adapter ready', flush=True)
slot, touching, was_touching, x, y = 0, False, False, 0, 0
try:
    while True:
        data = os.read(source, EVENT.size * 64)
        for offset in range(0, len(data), EVENT.size):
            sec, usec, kind, code, value = EVENT.unpack_from(data, offset)
            if kind == 3:
                if code == 0x2f:
                    slot = value
                elif slot == 0:
                    if code == 0x39:
                        touching = value >= 0
                    elif code == 0x35:
                        x = value
                    elif code == 0x36:
                        y = value
            elif kind == 0 and code == 0:
                out = [(3, 0, x), (3, 1, y)] if touching else []
                if touching != was_touching:
                    out.append((1, 0x110, int(touching)))
                    if timing:
                        print('touch_edge state=%d kernel_to_bridge_us=%d mono_ms=%d' %
                              (touching, time.monotonic_ns() // 1000 - (sec * 1000000 + usec),
                               time.monotonic_ns() // 1000000), flush=True)
                out.append((0, 0, 0))
                os.write(target, b''.join(EVENT.pack(0, 0, *e) for e in out))
                was_touching = touching
finally:
    fcntl.ioctl(target, 0x5502)  # UI_DEV_DESTROY
    os.close(target)
    os.close(source)
